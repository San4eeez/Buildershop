<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Buildershop.Glavnoe"
        x:CompileBindings="False"
        Title="Glavnoe">
  <Grid ShowGridLines="False" ColumnDefinitions="*,*,*" RowDefinitions="40,*,*"> 
      
    <TextBox Name="SearchBox" Watermark="search" KeyUp="SearchBox_KeyUp"></TextBox>

      <ComboBox Grid.Column="1" Name="SortBox" PlaceholderText="Sort" SelectionChanged="SortBox_SelectionChanged">
          <ComboBoxItem>по возрастанию</ComboBoxItem>
                    <ComboBoxItem>по убыванию</ComboBoxItem>
      </ComboBox>

      <StackPanel Grid.Column="2" Orientation="Horizontal">
          <TextBlock Name="fio"></TextBlock>
          <Button Name="Zakaziki" Content="заказы" Click="Zakaziki_Click"></Button>
          <Button Name="NewTovar" Content="добавить товар" Click="NewTovar_Click"></Button>
          <Button Name="Exit" Content="Exit" Click="Exit_Click"></Button>
      </StackPanel>

      <ListBox SelectionChanged="ListProduct_SelectionChanged" Name="ListProduct" Grid.Row="1" Grid.ColumnSpan="3" Grid.RowSpan="3">
          <ListBox.ItemTemplate>
              <DataTemplate>
                  <Grid ShowGridLines="True" ColumnDefinitions="*,*,20" RowDefinitions="200,*,*">
                      <Image Source="{Binding GetImage}"></Image>

                      <StackPanel Grid.Column="1">
                          <TextBlock TextWrapping="Wrap" Text="{Binding Name, StringFormat={}Наименование: {0}}"></TextBlock>
                          <TextBlock Text="{Binding Colvo, StringFormat={}Кол-во на складе: {0}}"></TextBlock>
                          <TextBlock TextWrapping="Wrap" Text="{Binding Description, StringFormat={}Описание: {0}}"></TextBlock>
                          <TextBlock TextWrapping="Wrap" Text="{Binding Creator, StringFormat={}Производитель: {0}}"></TextBlock>

                          <Button Name="Remove" Content="Remove" Tag="{Binding Id}" Click="Remove_Click"></Button>
                      </StackPanel>

                  </Grid>
              </DataTemplate>
          </ListBox.ItemTemplate>
      </ListBox>

      <ListBox IsVisible="False"  Name="ListProduct2" Grid.Row="1" Grid.ColumnSpan="3" Grid.RowSpan="3">
          <ListBox.ItemTemplate>
              <DataTemplate>
                  <Grid ShowGridLines="True" ColumnDefinitions="*,*,20" RowDefinitions="200,*,*">
                      <Image Source="{Binding GetImage}"></Image>

                      <StackPanel Grid.Column="1">
                          <TextBlock TextWrapping="Wrap" Text="{Binding Name, StringFormat={}Наименование: {0}}"></TextBlock>
                          <TextBlock Text="{Binding Colvo, StringFormat={}Кол-во на складе: {0}}"></TextBlock>
                          <TextBlock TextWrapping="Wrap" Text="{Binding Description, StringFormat={}Описание: {0}}"></TextBlock>
                          <TextBlock TextWrapping="Wrap" Text="{Binding Creator, StringFormat={}Производитель: {0}}"></TextBlock>

                      </StackPanel>

                  </Grid>
              </DataTemplate>
          </ListBox.ItemTemplate>
      </ListBox>

  </Grid>
</Window>
